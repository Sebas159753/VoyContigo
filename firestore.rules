rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: Verifica si el usuario está logueado
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Usuarios
    match /users/{userId} {
      // Cualquiera autenticado puede leer para ver nombres y perfiles
      allow read: if isAuthenticated();
      // Solo el propio usuario puede crear su documento
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // El propio usuario puede actualizar pero NO sus finanzas. Otros solo pueden actualizar su rating.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'freeUses', 'isSubscribed', 'completedTrips'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalRatings']) 
         && request.resource.data.rating is number 
         && request.resource.data.rating >= 1.0 
         && request.resource.data.rating <= 5.0)
      );
      allow delete: if false; // No permitimos borrar cuentas directamente por ahora
    }

    // 2. Viajes (Trips)
    match /trips/{tripId} {
      // Solo autenticados pueden ver los viajes
      allow read: if isAuthenticated();
      
      // Solo autenticados pueden crear, y el creatorUid debe ser el suyo. Precio debe ser >= 0
      allow create: if isAuthenticated() && 
                    request.resource.data.creatorUid == request.auth.uid &&
                    request.resource.data.price is number &&
                    request.resource.data.price >= 0;
      
      // Actualización
      allow update: if isAuthenticated() && (
        // El creador original puede modificarlo
        resource.data.creatorUid == request.auth.uid ||
        // O un tercero puede actualizarlo SOLO para aceptarlo
        (request.resource.data.status == 'ACCEPTED' && request.resource.data.acceptedByUid == request.auth.uid) ||
        // O un tercero puede actualizarlo SOLO para cancelarlo si es participante
        (request.resource.data.status == 'CANCELLED' && (resource.data.acceptedByUid == request.auth.uid || resource.data.creatorUid == request.auth.uid)) ||
        // O un pasajero puede unirse/cancelar su cupo, pero solo modificando su propia membresía
        (resource.data.isOffer == true && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passengers', 'passengerUids', 'availableSeats', 'status']) &&
         (
           (request.auth.uid in request.resource.data.passengerUids && !(request.auth.uid in resource.data.passengerUids)) ||
           (!(request.auth.uid in request.resource.data.passengerUids) && request.auth.uid in resource.data.passengerUids)
         )
        )
      );
      
      allow delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;

      // 3. Sub-colección de Mensajes de Chat
      match /chat_messages/{messageId} {
        // Solo pueden leer y escribir si son el creador o quien aceptó el viaje
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.creatorUid == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.acceptedByUid == request.auth.uid
        );
      }
    }

    // 4. Coincidencias (Matches)
    match /matches/{matchId} {
      // Solo pueden leer los involucrados
      allow read: if isAuthenticated() && (
        resource.data.offerUserId == request.auth.uid || 
        resource.data.demandUserId == request.auth.uid
      );
      // Funciones pueden crear. Clientes pueden actualizar a ACCEPTED.
      allow create, delete: if false;
      allow update: if isAuthenticated() && 
        (resource.data.offerUserId == request.auth.uid || resource.data.demandUserId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'ACCEPTED';
    }
  }
}
